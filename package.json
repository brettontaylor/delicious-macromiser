{
  "name": "delicious-macromiser",
  "version": "0.1.0",
  "private": true,
  "description": "Recipes + Macros \u2014 structured memory for AI-assisted cooking, training, and nutrition.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dm/server",
    "test": "npm run test --workspace @dm/server",
    "typecheck": "npm run typecheck --workspace @dm/server",
    "deploy:prod": "npm run recipes:build && npm run deploy:prod --workspace @dm/server",
    "smoke": "npm run smoke --workspace @dm/server",
    "recipes:check": "node scripts/check-recipes.mjs",
    "backup:restore": "npm run restore --workspace @dm/server --",
    "recipes:build": "node scripts/build-recipe-catalog.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
